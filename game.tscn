theme_override_fonts/normal_font = ExtResource("3_hve3p")
theme_override_font_sizes/normal_font_size = 24
text = "Ah you poor thing, everyone's telling me that there is no way you'll pass the first night unscathed, but I know you'll entertain me for much longer than that right...

You can use LEFT and RIGHT arrow key to move, not that you can do much in this state... You can also press ESC to PAUSE the game. Can't use that to pause me though...

Anyway, enjoy this calm window before the storm arrive... or press ENTER to make the night approach immediately"
horizontal_alignment = 1

[node name="Day1Text" type="RichTextLabel" parent="EventTextBox" unique_id=745431296]
